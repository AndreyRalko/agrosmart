#: fertilizer/views.py
msgid "Mineral fertilizer utilization coefficient cannot be zero."
msgstr "Коэффициент использования из минерального удобрения не может быть нулевым."

#: fertilizer/views.py
msgid "NPK removal must be an object."
msgstr "Вынос NPK должен быть объектом."

#: fertilizer/views.py
#, python-format
msgid "NPK removal for %(nutrient)s is not filled."
msgstr "Вынос NPK для %(nutrient)s не заполнен."

#: fertilizer/views.py
#, python-format
msgid "NPK removal for %(nutrient)s must be a number."
msgstr "Вынос NPK для %(nutrient)s должен быть числом."

#: animal/serializers.py:46
msgid "Animal with this tag already exists."
msgstr "Животное с таким номером бирки уже существует."

#: core/serializer.py:136
msgid "This field is required."
msgstr "Это поле обязательно."

#: core/serializer.py:156
msgid "This field cannot be empty for required translations."
msgstr "Это поле не может быть пустым для обязательных переводов."

#: field/serializers.py:32
msgid "Field with this number already exists."
msgstr "Поле с таким номером уже существует."

#: machinery/serializers.py:58
msgid "Machinery with this government number already exists."
msgstr "Техника с таким государственным номером уже существует."

